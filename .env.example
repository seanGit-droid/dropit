APP_ENV=production
DB_DRIVER=mysql
DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=dropit
DB_USERNAME=your-mysql-user
DB_PASSWORD=your-mysql-password
DB_CHARSET=utf8mb4

# Optional: CA file for verified MySQL TLS (for example an Aiven project CA).
DB_SSL_CA=/var/www/html/database/certs/aiven-ca.pem

# HTTPS email transport for hosts that block SMTP. Keep the real key in Render.
BREVO_API_KEY=
BREVO_FROM_EMAIL=

# Permanent private proof images. In production, missing credentials block saves
# rather than silently falling back to Render's ephemeral filesystem.
PROOF_STORAGE=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Local development may explicitly use PROOF_STORAGE=local.
