APP_ENV=production
DB_DRIVER=mysql
DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=dropit
DB_USERNAME=your-mysql-user
DB_PASSWORD=your-mysql-password
DB_CHARSET=utf8mb4

# Optional: CA file for verified MySQL TLS (for example an Aiven project CA).
DB_SSL_CA=/var/www/html/database/certs/aiven-ca.pem

# HTTPS email transport for hosts that block SMTP. Keep the real key in Render.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
